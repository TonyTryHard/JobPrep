# Auto detect text files and normalize line endings
* text=auto

# Enforce LF on Linux/Unix scripts and sources
*.sh text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
CMakePresets.json text eol=lf
*.qss text eol=lf
*.qrc text eol=lf
*.json text eol=lf
*.md text eol=lf

# Enforce CRLF on Windows PowerShell scripts and batch files
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
*.ttf binary
*.otf binary
